<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="88dp"
        android:paddingBottom="24dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- Instruction caption card: what to do on this step, in plain words -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_whatsapp_guide_card"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tvStepTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/call_forwarding_step_title"
                android:textColor="@color/guide_card_title_text"
                android:textSize="19sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/tvStepBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/call_forwarding_step_body"
                android:textColor="@color/guide_card_subtitle_text"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.15"
                android:fontFamily="sans-serif" />

        </LinearLayout>

        <!-- Screenshot area: shown inside a phone-shaped frame so it reads as a demo, not a real live screen -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="18dp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/bg_phone_mockup_frame"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/ivStepImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <View
                    android:layout_width="44dp"
                    android:layout_height="5dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_phone_notch" />

            </FrameLayout>

        </FrameLayout>

        <TextView
            android:id="@+id/btnPrimaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_primary_action_button"
            android:text="@string/call_forwarding_button_text"
            android:textColor="@color/text_on_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:gravity="center"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="4dp" />

    </LinearLayout>

    <!-- Note: no step-progress dots here (single-step screen) — this space is
         intentionally left empty so the layout matches the WhatsApp guide screen. -->

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:padding="9dp"
        android:background="@drawable/bg_fix_issue_button"
        android:src="@drawable/ic_back_arrow"
        android:contentDescription="@null"
        android:clickable="true"
        android:focusable="true"
        android:elevation="12dp" />

</FrameLayout>
