<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_gradient">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="36dp"
        android:paddingEnd="36dp">

        <!-- Clean Storage badge -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_storage_icon_circle">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_storage_clean"
                android:contentDescription="@null" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvStorageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/clean_storage_title"
            android:textColor="@color/home_button_text"
            android:textStyle="bold"
            android:textSize="19sp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.01" />

        <TextView
            android:id="@+id/tvStorageSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/home_button_text"
            android:alpha="0.75"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp"
            android:fontFamily="sans-serif" />

        <View
            android:layout_width="40dp"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="@color/progress_dot_inactive" />

        <TextView
            android:id="@+id/tvWatchAdLine2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/watch_ad_title_line2"
            android:textColor="@color/progress_dot_active"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textAllCaps="true"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.03" />

        <TextView
            android:id="@+id/btnOpen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_check_now_button"
            android:text="@string/open_button_text"
            android:textColor="@color/home_button_text"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:paddingStart="34dp"
            android:paddingEnd="34dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnNoThanks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/no_thanks_button_text"
            android:textColor="@color/home_button_text"
            android:textSize="13sp"
            android:alpha="0.55"
            android:textAllCaps="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</FrameLayout>
