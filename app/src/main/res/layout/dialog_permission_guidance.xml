<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_whatsapp_guide_card"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="30dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/tvGuidancePermissions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Permissions"
        android:textColor="@color/guide_card_title_text"
        android:textSize="26sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif" />

    <TextView
        android:id="@+id/tvGuidanceArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="⬇️"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/tvGuidanceSms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="SMS"
        android:textColor="@color/guide_card_title_text"
        android:textSize="26sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif" />

    <TextView
        android:id="@+id/tvGuidanceHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="App Info khulega. Permissions me jaake SMS allow/deny karein."
        android:textColor="@color/guide_card_subtitle_text"
        android:textSize="13sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.1"
        android:fontFamily="sans-serif" />

    <TextView
        android:id="@+id/btnGuidanceClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_view_guide_button"
        android:text="Close (5)"
        android:textColor="@color/guide_card_button_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:gravity="center"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:enabled="false"
        android:alpha="0.5"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
