<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_gradient">

    <LinearLayout
        android:id="@+id/homeLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="top|center_horizontal"
        android:paddingTop="48dp">

        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="hh\nmm"
            android:format24Hour="@null"
            android:textColor="@color/home_button_text"
            android:textSize="72sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="40sp"
            android:autoSizeMaxTextSize="72sp"
            android:maxLines="2"
            android:lineSpacingMultiplier="0.9"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:textStyle="bold|italic"
            android:letterSpacing="0.01" />

        <TextClock
            android:id="@+id/dateClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:format12Hour="EEE d MMMM"
            android:format24Hour="EEE d MMMM"
            android:textColor="@color/home_button_text"
            android:textSize="15sp"
            android:textAllCaps="true"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.05" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/drawerLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_home_gradient"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/dragHandle"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_drawer_handle" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/adSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp">

                <include
                    android:id="@+id/nativeAdContainer"
                    layout="@layout/item_native_ad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="invisible" />

                <TextView
                    android:id="@+id/tvNoSponsorship"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:gravity="center"
                    android:text="@string/no_sponsorship_available"
                    android:textColor="@color/home_button_text"
                    android:textSize="12sp"
                    android:alpha="0.6"
                    android:fontFamily="sans-serif"
                    android:clickable="false"
                    android:focusable="false"
                    android:visibility="visible" />

                <FrameLayout
                    android:id="@+id/adShimmerLoader"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:background="@drawable/bg_native_ad_card"
                    android:clickable="false"
                    android:focusable="false"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/home_button_text" />

                </FrameLayout>

            </FrameLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvApps"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="24dp" />

        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/swipeUpHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="false"
        android:focusable="false">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron_up"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/all_apps_hint"
            android:textAllCaps="true"
            android:textColor="@color/home_button_text"
            android:textSize="11sp"
            android:letterSpacing="0.08" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnFixIssue"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_fix_issue_button"
        android:src="@drawable/ic_fix_issue"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:alpha="0.35"
        android:contentDescription="@string/fix_issue_content_description"
        android:elevation="12dp"
        android:visibility="gone" />

</FrameLayout>
