<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_gradient">

    <LinearLayout
        android:id="@+id/homeLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="top|center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="48dp">

        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="hh\nmm"
            android:format24Hour="@null"
            android:textColor="@color/home_button_text"
            android:textSize="72sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="40sp"
            android:autoSizeMaxTextSize="72sp"
            android:maxLines="2"
            android:lineSpacingMultiplier="0.9"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:textStyle="bold|italic"
            android:letterSpacing="0.01" />

        <TextClock
            android:id="@+id/dateClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:format12Hour="EEE d MMMM"
            android:format24Hour="EEE d MMMM"
            android:textColor="@color/home_button_text"
            android:textSize="15sp"
            android:textAllCaps="true"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.05" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:id="@+id/btnCheckPhoneHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_check_phone_history_button"
                android:text="@string/check_phone_history_button_text"
                android:textColor="@color/check_phone_history_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvNewBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="-10dp"
                android:layout_marginEnd="-10dp"
                android:background="@drawable/bg_new_badge"
                android:text="@string/new_badge_text"
                android:textColor="@color/text_on_primary"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:elevation="4dp"
                android:clickable="false"
                android:focusable="false" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/whatsappCheckBlock"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="40dp">

            <LinearLayout
                android:id="@+id/whatsappGuideCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_whatsapp_guide_card"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivWhatsappCheck"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_whatsapp_guide"
                        android:contentDescription="@string/whatsapp_guide_title" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvWhatsappCheckTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/whatsapp_guide_title"
                            android:textColor="@color/guide_card_title_text"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif" />

                        <TextView
                            android:id="@+id/tvWhatsappCheckSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/whatsapp_guide_status_not_viewed"
                            android:textColor="@color/guide_card_subtitle_text"
                            android:textSize="13sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif" />

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/guide_card_divider" />

                <TextView
                    android:id="@+id/btnCheckWhatsappNow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_view_guide_button"
                    android:text="@string/whatsapp_guide_button_view"
                    android:textColor="@color/guide_card_button_text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:gravity="center"
                    android:paddingTop="13dp"
                    android:paddingBottom="13dp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/featuresNavRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/btnFeaturesLeft"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_nav_arrow_button"
                    android:src="@drawable/ic_back_arrow"
                    android:layout_marginEnd="4dp"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/features_nav_label" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvFeaturesLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_features_label"
                        android:text="@string/features_nav_label"
                        android:textColor="@color/home_button_text"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:fontFamily="sans-serif"
                        android:letterSpacing="0.03"
                        android:clickable="false"
                        android:focusable="false" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/btnFeaturesRight"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_nav_arrow_button"
                    android:src="@drawable/ic_forward_arrow"
                    android:layout_marginStart="4dp"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/features_nav_label" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/drawerLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_home_gradient"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/dragHandle"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_drawer_handle" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/adSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp">

                <include
                    android:id="@+id/nativeAdContainer"
                    layout="@layout/item_native_ad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="invisible" />

                <TextView
                    android:id="@+id/tvNoSponsorship"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:gravity="center"
                    android:text="@string/no_sponsorship_available"
                    android:textColor="@color/home_button_text"
                    android:textSize="12sp"
                    android:alpha="0.6"
                    android:fontFamily="sans-serif"
                    android:clickable="false"
                    android:focusable="false"
                    android:visibility="visible" />

                <FrameLayout
                    android:id="@+id/adShimmerLoader"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:background="@drawable/bg_native_ad_card"
                    android:clickable="false"
                    android:focusable="false"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/home_button_text" />

                </FrameLayout>

            </FrameLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvApps"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="24dp" />

        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/swipeUpHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="false"
        android:focusable="false">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_chevron_up"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/all_apps_hint"
            android:textAllCaps="true"
            android:textColor="@color/home_button_text"
            android:textSize="11sp"
            android:letterSpacing="0.08" />

    </LinearLayout>

    <TextView
        android:id="@+id/btnFixIssue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_fix_issue_button"
        android:text="@string/fix_issues_button_text"
        android:textColor="@color/fix_issue_text"
        android:textSize="11sp"
        android:textAllCaps="false"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:alpha="0.35"
        android:clickable="true"
        android:focusable="true"
        android:elevation="12dp" />

</FrameLayout>
